# Nom de domaine pointant vers le serveur (enregistrement DNS A/AAAA)
DOMAIN=www.manifriend.com
# Autres adresses redirigées vers DOMAIN (séparées par des espaces), ex. le domaine sans www
EXTRA_DOMAINS=manifriend.com
# Clé pour l'espace organisateur·ices (tracé des parcours officiels). Générer avec : openssl rand -base64 24
ADMIN_KEY=
# Secret serveur (identifiants anonymes stables). Générer avec : openssl rand -hex 32
SERVER_SECRET=
# Niveau de détail de la carte de France : 12 (≈1,1 Go), 13 (≈2,3 Go) ou 14 (≈4,4 Go, recommandé)
MAP_MAXZOOM=14
# Textes juridiques (/mentions-legales et /confidentialite) : affichés tels quels, « [à compléter] » si vide
LEGAL_EDITEUR=
LEGAL_DIRECTEUR=
LEGAL_CONTACT=
LEGAL_HEBERGEUR=
LEGAL_HEBERGEUR_ADRESSE=
# Date d'entrée en vigueur des textes (ex. 17 octobre 2026)
LEGAL_DATE=
